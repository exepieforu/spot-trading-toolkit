# paper = simulated (no keys needed) | testnet = Binance fake-money | live = REAL MONEY
MODE=paper
# Only needed for testnet/live. Create keys with "Enable Spot Trading" ONLY.
# NEVER enable withdrawals. Restrict the key to your server's IP address.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Required (in addition to MODE=live) to trade real money
CONFIRM_LIVE=NO

SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m

# The most the bot is ever allowed to deploy, in USDT
CAPITAL_USDT=500
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=20
DAILY_LOSS_LIMIT_PCT=3

# 0.001 standard, 0.00075 if paying fees with BNB
FEE_RATE=0.001
